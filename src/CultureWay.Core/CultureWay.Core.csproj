<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Core abstractions for CultureWay: the IStore and IReadOnlySource interfaces and the Translation model. Reference this package when implementing a custom persistence backend.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>localization;i18n;translations;abstractions;aspnetcore</PackageTags>
        <RepositoryUrl>https://github.com/kododo-dev/CultureWay</RepositoryUrl>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>1.0.0-local</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include=".nuget\logo.png" Pack="true" PackagePath="\" />
        <None Include=".nuget\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>
