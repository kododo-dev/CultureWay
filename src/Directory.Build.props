<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Kododo</Authors>
    <Company>Kododo</Company>
    <Copyright>Copyright (c) 2026 Kododo</Copyright>
    <PackageProjectUrl>https://github.com/kododo-dev/CultureWay</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Debuggability for package consumers: XML docs, portable symbols (.snupkg) and SourceLink. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Kododo.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Kododo.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Kododo.$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

</Project>
