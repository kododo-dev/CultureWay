<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <EmbeddedResource Include="SPA\dist\**\*" />
    </ItemGroup>

    <PropertyGroup>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Kododo.Reiho.AspNetCore" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CultureWay\CultureWay.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".nuget\logo.png" Pack="true" PackagePath="\" />
        <None Include=".nuget\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Kododo.CultureWay.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup>
        <Description>Embedded web UI for CultureWay. Adds a React-based localization editor served directly from the host application — no separate deployment required.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>localization;i18n;translations;editor;web-ui;aspnetcore;react</PackageTags>
        <RepositoryUrl>https://github.com/kododo-dev/CultureWay</RepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>1.0.0-local</Version>
    </PropertyGroup>

    <!-- Fail packing instead of silently shipping a UI package without the embedded SPA. -->
    <Target Name="EnsureSpaBuilt" BeforeTargets="Pack">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/SPA/dist/index.html')"
               Text="SPA\dist\index.html is missing. Run 'npm ci &amp;&amp; npm run build' in src/CultureWay.UI/SPA before packing." />
    </Target>

</Project>
